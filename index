<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>رحلة الكون - المرحلة الأولى</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
    body { min-height: 100vh; display: flex; justify-content: center; align-items: center; background: radial-gradient(circle at center, #111b2b 0%, #080c14 100%); color: #fff; overflow: hidden; position: relative; }
    .stars { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(2px 2px at 20px 30px, #ffffff, transparent), radial-gradient(2px 2px at 40px 70px, #ffffff, transparent), radial-gradient(1px 1px at 90px 40px, #ffffff, transparent), radial-gradient(2px 2px at 160px 120px, #ffffff, transparent); background-repeat: repeat; background-size: 200px 200px; opacity: 0.7; animation: twinkle 3s infinite ease-in-out; pointer-events: none; }
    @keyframes twinkle { 0%, 100% { opacity: 0.4; } 50% { opacity: 0.9; } }
    .moon { position: absolute; top: 40px; left: 40px; font-size: 45px; filter: drop-shadow(0 0 10px rgba(255, 230, 0, 0.6)); }
    .card { width: min(90%, 450px); background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border: 1px solid rgba(255, 255, 255, 0.15); border-radius: 24px; padding: 30px 25px; text-align: center; box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5); z-index: 10; }
    .phase-title { font-size: 1rem; color: #ffeaa7; margin-bottom: 10px; }
    .question-title { font-size: 1.4rem; font-weight: bold; margin-bottom: 25px; line-height: 1.5; }
    .options-grid { display: flex; flex-direction: column; gap: 12px; }
    .btn-option { background: rgba(255, 255, 255, 0.08); border: 1px solid rgba(255, 255, 255, 0.2); color: #fff; padding: 14px 20px; border-radius: 16px; font-size: 1.05rem; cursor: pointer; transition: all 0.3s ease; }
    .btn-option:hover { background: rgba(255, 215, 0, 0.2); transform: translateY(-2px); }
    .btn-correct { background: rgba(46, 204, 113, 0.4) !important; border-color: #2ecc71 !important; }
    .btn-wrong { background: rgba(231, 76, 60, 0.4) !important; border-color: #e74c3c !important; animation: shake 0.4s; }
    @keyframes shake { 0%, 100% { transform: translateX(0); } 25% { transform: translateX(-5px); } 75% { transform: translateX(5px); } }
    .progress-bar { width: 100%; height: 6px; background: rgba(255, 255, 255, 0.1); border-radius: 10px; margin-top: 25px; overflow: hidden; }
    .progress { height: 100%; background: linear-gradient(90deg, #ffeaa7, #fdcb6e); width: 0%; transition: 0.4s ease; }
    .feedback { margin-top: 15px; font-size: 1.1rem; min-height: 25px; font-weight: bold; color: #ffd700; opacity: 0; transition: 0.3s; }
    .end-screen { display: none; }
    .end-screen h1 { font-size: 2rem; color: #ffeaa7; margin-bottom: 20px; }
  </style>
</head>
<body>
  <div class="stars"></div>
  <div class="moon">🌙</div>
  <div class="card" id="gameCard">
    <div class="phase-title" id="phaseTitle">المرحلة الأولى — ذكرياتنا ❤️</div>
    <h2 class="question-title" id="questionText">جاري التحميل...</h2>
    <div class="options-grid" id="optionsContainer"></div>
    <div class="feedback" id="feedbackMsg"></div>
    <div class="progress-bar"><div class="progress" id="progressFill"></div></div>
  </div>
  <div class="card end-screen" id="endCard">
    <h1>🏆 نهاية المرحلة الأولى</h1>
    <h2>5/5 ❤</h2>
    <p style="margin-top: 15px; color: #e0e6ed;">عاشت إيدج أميرة قلبي! جاهزة للمرحلة الجاية؟ 😏</p>
  </div>
  <script>
    const questions = [
      { text: "🎵 السؤال الأول<br>شنو اسم أول أغنية كانت بيناتنه؟", options: ["❤️ يوي يوي — بلقيس", "🤍🎵 أنت عمري — أم كلثوم", "🌙 حلف القمر — جورج وسوف", "⭐ حرام — ماجد المهندس"], correct: 0, replyRight: "أكيد ما تنسين أغنيتنا! ❤️", replyWrong: "لا يا عيني، ركزي! 🥺" },
      { text: "💕 السؤال الثاني<br>شنو أول لقب حلو خليته إلج؟", options: ["🌙 قمري", "👑 أميرة قلبي", "😈 شيطانتي الصغيرة", "🦋 ملاكي", "👑💪 أميرة قلبي المعضلة"], correct: 1, replyRight: "وتبقين أميرة قلبي للأبد! 👑❤️", replyWrong: "زعلتيني والله! 💔" },
      { text: "💍 السؤال الثالث<br>شنو الشي اللي وعدنا بعض أبد ما ننزعه؟", options: ["❤️ الخاتم", "🧿 السوار", "🔗 السلسلة", "🤍 العقد"], correct: 1, replyRight: "عفيه عليج 😭❤️ هسه إنتي لابسته… عادي تبوسيه؟ 😏💋", replyWrong: "نسيتي وعدنا؟ 🥺" },
      { text: "😏 السؤال الرابع<br>شنو أكثر شي كنت أحب أتغزل بيج بيه؟", options: ["👀 عيونج", "🗣️ سوالفج", "💇🏻‍♀️ شعرج", "😊 ضحكتج", "❤️ كلشي بيج"], correct: 4, replyRight: "فدوه لكلشي بيج! ❤️", replyWrong: "كلهم حلوين، بس اكو اختيار أصح! 😉" },
      { text: "🐥 السؤال الخامس<br>أني شنو اسمي؟ 😏❤️", options: ["😂 عبودي", "😎 آدم", "🤨 إبراهيم", "🇱🇧 محمد", "🐥❤️ فاضل"], correct: 4, replyRight: "عفيه عليج 😭❤️ هسه عرفتي كتكوتج 🐥❤️", replyWrong: "ها نسيتي كتكوتج؟ 😭😂❤️" }
    ];
    let currentQ = 0;
    function loadQuestion() {
      const q = questions[currentQ];
      document.getElementById('questionText').innerHTML = q.text;
      document.getElementById('feedbackMsg').style.opacity = "0";
      const optionsContainer = document.getElementById('optionsContainer');
      optionsContainer.innerHTML = '';
      q.options.forEach((opt, index) => {
        const btn = document.createElement('button');
        btn.className = 'btn-option';
        btn.innerHTML = opt;
        btn.onclick = () => checkAnswer(index, btn);
        optionsContainer.appendChild(btn);
      });
      document.getElementById('progressFill').style.width = `${(currentQ / questions.length) * 100}%`;
    }
    function checkAnswer(selectedIndex, btn) {
      const q = questions[currentQ];
      const feedback = document.getElementById('feedbackMsg');
      const allBtns = document.querySelectorAll('.btn-option');
      allBtns.forEach(b => b.style.pointerEvents = 'none');
      if (selectedIndex === q.correct) {
        btn.classList.add('btn-correct');
        feedback.innerHTML = q.replyRight;
        feedback.style.color = "#2ecc71";
        feedback.style.opacity = "1";
        setTimeout(() => {
          currentQ++;
          if (currentQ < questions.length) { loadQuestion(); }
          else { document.getElementById('gameCard').style.display = 'none'; document.getElementById('endCard').style.display = 'block'; }
        }, 2500);
      } else {
        btn.classList.add('btn-wrong');
        feedback.innerHTML = q.replyWrong;
        feedback.style.color = "#e74c3c";
        feedback.style.opacity = "1";
        setTimeout(() => { btn.classList.remove('btn-wrong'); feedback.style.opacity = "0"; allBtns.forEach(b => b.style.pointerEvents = 'auto'); }, 1500);
      }
    }
    loadQuestion();
  </script>
</body>
</html>
